<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier><SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile><IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <StartupObject>PortableProgram</StartupObject><AssemblyName>Quotamon</AssemblyName>
    <Version>0.3.0</Version><Product>Quotamon</Product><Description>Portable Orca quota BLE bridge</Description>
  </PropertyGroup>
  <ItemGroup><Compile Include="../orca-integration/windows/Program.cs" Link="BleResource.cs" /></ItemGroup>
</Project>
